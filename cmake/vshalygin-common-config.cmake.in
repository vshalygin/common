@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads)
find_dependency(Boost 1.86 COMPONENTS thread)
find_dependency(Protobuf CONFIG)

if(NOT TARGET Boost::headers AND TARGET Boost::boost)
    add_library(Boost::headers INTERFACE IMPORTED)
    set_property(TARGET Boost::headers PROPERTY
        INTERFACE_LINK_LIBRARIES Boost::boost
    )
endif()

include("${CMAKE_CURRENT_LIST_DIR}/vshalygin-common-targets.cmake")

check_required_components(vshalygin-common)
