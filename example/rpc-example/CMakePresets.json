{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_INSTALL": true,
        "VCPKG_OVERLAY_PORTS": ""
      }
    },
    {
      "name": "vs2022-x64",
      "displayName": "RPC Example - Visual Studio 2022 x64",
      "description": "Build the RPC example against the installed x64 package",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/../../out/build/rpc-example/vs2022-x64",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "toolset": {
        "value": "v143,host=x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/../../out/install/vs2022-x64",
        "CMAKE_SYSTEM_VERSION": "10.0",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_HOST_TRIPLET": "x64-windows-static"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "vs2022-win32",
      "displayName": "RPC Example - Visual Studio 2022 Win32",
      "description": "Build the RPC example against the installed Win32 package",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/../../out/build/rpc-example/vs2022-win32",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "toolset": {
        "value": "v143,host=x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/../../out/install/vs2022-win32",
        "CMAKE_SYSTEM_VERSION": "10.0",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "VCPKG_TARGET_TRIPLET": "x86-windows-static",
        "VCPKG_HOST_TRIPLET": "x64-windows-static"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-gcc-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "RPC Example - Linux GCC Debug",
      "inherits": "linux-gcc-base",
      "binaryDir": "${sourceDir}/../../out/build/rpc-example/linux-gcc-debug",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/../../out/install/linux-gcc-debug",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "RPC Example - Linux GCC Release",
      "inherits": "linux-gcc-base",
      "binaryDir": "${sourceDir}/../../out/build/rpc-example/linux-gcc-release",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/../../out/install/linux-gcc-release",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-gcc-x86-base",
      "hidden": true,
      "inherits": "linux-gcc-base",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-m32",
        "VCPKG_TARGET_TRIPLET": "x86-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-gcc-x86-debug",
      "displayName": "RPC Example - Linux GCC x86 Debug",
      "inherits": "linux-gcc-x86-base",
      "binaryDir": "${sourceDir}/../../out/build/rpc-example/linux-gcc-x86-debug",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/../../out/install/linux-gcc-x86-debug",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-gcc-x86-release",
      "displayName": "RPC Example - Linux GCC x86 Release",
      "inherits": "linux-gcc-x86-base",
      "binaryDir": "${sourceDir}/../../out/build/rpc-example/linux-gcc-x86-release",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/../../out/install/linux-gcc-x86-release",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-clang-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "RPC Example - Linux Clang Debug",
      "inherits": "linux-clang-base",
      "binaryDir": "${sourceDir}/../../out/build/rpc-example/linux-clang-debug",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/../../out/install/linux-clang-debug",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-clang-release",
      "displayName": "RPC Example - Linux Clang Release",
      "inherits": "linux-clang-base",
      "binaryDir": "${sourceDir}/../../out/build/rpc-example/linux-clang-release",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/../../out/install/linux-clang-release",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-clang-x86-base",
      "hidden": true,
      "inherits": "linux-clang-base",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-m32",
        "VCPKG_TARGET_TRIPLET": "x86-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-clang-x86-debug",
      "displayName": "RPC Example - Linux Clang x86 Debug",
      "inherits": "linux-clang-x86-base",
      "binaryDir": "${sourceDir}/../../out/build/rpc-example/linux-clang-x86-debug",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/../../out/install/linux-clang-x86-debug",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-clang-x86-release",
      "displayName": "RPC Example - Linux Clang x86 Release",
      "inherits": "linux-clang-x86-base",
      "binaryDir": "${sourceDir}/../../out/build/rpc-example/linux-clang-x86-release",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/../../out/install/linux-clang-x86-release",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2022-x64-debug",
      "configurePreset": "vs2022-x64",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-x64-release",
      "configurePreset": "vs2022-x64",
      "configuration": "Release"
    },
    {
      "name": "vs2022-win32-debug",
      "configurePreset": "vs2022-win32",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-win32-release",
      "configurePreset": "vs2022-win32",
      "configuration": "Release"
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug"
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release"
    },
    {
      "name": "linux-gcc-x86-debug",
      "configurePreset": "linux-gcc-x86-debug"
    },
    {
      "name": "linux-gcc-x86-release",
      "configurePreset": "linux-gcc-x86-release"
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug"
    },
    {
      "name": "linux-clang-release",
      "configurePreset": "linux-clang-release"
    },
    {
      "name": "linux-clang-x86-debug",
      "configurePreset": "linux-clang-x86-debug"
    },
    {
      "name": "linux-clang-x86-release",
      "configurePreset": "linux-clang-x86-release"
    }
  ]
}
