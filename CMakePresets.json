{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_INSTALL": true,
        "VCPKG_OVERLAY_PORTS": ""
      }
    },
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 x64",
      "description": "Configure all libraries, tests, and examples with MSVC v143",
      "inherits": "vcpkg-base",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/out/build/vs2022-x64",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "toolset": {
        "value": "v143,host=x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_VERSION": "10.0",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_HOST_TRIPLET": "x64-windows-static",
        "BUILD_TESTING": true,
        "BUILD_EXAMPLES": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "vs2022-win32",
      "displayName": "Visual Studio 2022 Win32",
      "description": "Configure all libraries, tests, and examples for Win32 with MSVC v143",
      "inherits": "vcpkg-base",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/out/build/vs2022-win32",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "toolset": {
        "value": "v143,host=x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_VERSION": "10.0",
        "VCPKG_TARGET_TRIPLET": "x86-windows-static",
        "VCPKG_HOST_TRIPLET": "x64-windows-static",
        "BUILD_TESTING": true,
        "BUILD_EXAMPLES": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-gcc-base",
      "hidden": true,
      "inherits": "vcpkg-base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": true,
        "BUILD_EXAMPLES": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC Debug",
      "description": "Configure libraries, portable tests, and examples with GCC",
      "inherits": "linux-gcc-base",
      "binaryDir": "${sourceDir}/out/build/linux-gcc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux GCC Release",
      "description": "Configure libraries, portable tests, and examples with GCC and LTO",
      "inherits": "linux-gcc-base",
      "binaryDir": "${sourceDir}/out/build/linux-gcc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-gcc-x86-base",
      "hidden": true,
      "inherits": "linux-gcc-base",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-m32",
        "VCPKG_TARGET_TRIPLET": "x86-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-gcc-x86-debug",
      "displayName": "Linux GCC x86 Debug",
      "description": "Configure 32-bit libraries, portable tests, and examples with GCC",
      "inherits": "linux-gcc-x86-base",
      "binaryDir": "${sourceDir}/out/build/linux-gcc-x86-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-gcc-x86-release",
      "displayName": "Linux GCC x86 Release",
      "description": "Configure 32-bit libraries, portable tests, and examples with GCC and LTO",
      "inherits": "linux-gcc-x86-base",
      "binaryDir": "${sourceDir}/out/build/linux-gcc-x86-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-clang-base",
      "hidden": true,
      "inherits": "vcpkg-base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": true,
        "BUILD_EXAMPLES": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux Clang Debug",
      "description": "Configure libraries, portable tests, and examples with Clang",
      "inherits": "linux-clang-base",
      "binaryDir": "${sourceDir}/out/build/linux-clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-clang-release",
      "displayName": "Linux Clang Release",
      "description": "Configure libraries, portable tests, and examples with Clang and LTO",
      "inherits": "linux-clang-base",
      "binaryDir": "${sourceDir}/out/build/linux-clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-clang-x86-base",
      "hidden": true,
      "inherits": "linux-clang-base",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-m32",
        "VCPKG_TARGET_TRIPLET": "x86-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-clang-x86-debug",
      "displayName": "Linux Clang x86 Debug",
      "description": "Configure 32-bit libraries, portable tests, and examples with Clang",
      "inherits": "linux-clang-x86-base",
      "binaryDir": "${sourceDir}/out/build/linux-clang-x86-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-clang-x86-release",
      "displayName": "Linux Clang x86 Release",
      "description": "Configure 32-bit libraries, portable tests, and examples with Clang and LTO",
      "inherits": "linux-clang-x86-base",
      "binaryDir": "${sourceDir}/out/build/linux-clang-x86-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
